{
  "name": "chess-clock-voice",
  "displayName": "Chess Clock Voice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Speaks the remaining time on your chess.com clock so you never lose on time again.",
  "scripts": {
    "dev": "npm run icons && vite",
    "build": "npm run icons && tsc --noEmit && vite build",
    "package": "npm run build && node scripts/package.mjs",
    "bump": "node scripts/bump-version.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.0",
    "@eslint/js": "^9.14.0",
    "@types/archiver": "^6.0.3",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
